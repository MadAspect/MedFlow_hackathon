# Copy to .env.local and fill in. Never commit .env.local.
#
# Supabase project URL and PUBLISHABLE (anon) key — Project Settings -> API.
# These are exposed to the browser, so they must be the publishable key only.
# NEVER put a secret or service-role key here: it bypasses Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Optional: set to "placeholder" to force the clearly-labelled placeholder engine.
# NEXT_PUBLIC_SIMULATION_ENGINE=real

# Optional: make simulations respect medicine and equipment stock (see the Inventory page).
# Off unless exactly "true", so existing results do not change. Restart `npm run dev` after changing.
# NEXT_PUBLIC_ENABLE_STOCK_CONSTRAINTS=true
